{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageOurGuardrail",
      "Effect": "Allow",
      "Action": [
        "bedrock:CreateGuardrail",
        "bedrock:UpdateGuardrail",
        "bedrock:GetGuardrail",
        "bedrock:CreateGuardrailVersion"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1:<ACCOUNT_ID>:guardrail/*",
        "arn:aws:bedrock:us-east-1:<ACCOUNT_ID>:guardrail-profile/us.guardrail.v1:0",
        "arn:aws:bedrock:us-east-2:<ACCOUNT_ID>:guardrail-profile/us.guardrail.v1:0",
        "arn:aws:bedrock:us-west-2:<ACCOUNT_ID>:guardrail-profile/us.guardrail.v1:0"
      ]
    },
    {
      "Sid": "ListGuardrails",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListGuardrails"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "EvalModels",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1:<ACCOUNT_ID>:inference-profile/us.anthropic.claude-haiku-5-5",
        "arn:aws:bedrock:us-east-1:<ACCOUNT_ID>:inference-profile/global.anthropic.claude-haiku-5-5",
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-haiku-5-5",
        "arn:aws:bedrock:us-east-2::foundation-model/anthropic.claude-haiku-5-5",
        "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-haiku-5-5"
      ]
    },
    {
      "Sid": "EvalGlobalModels",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": [
        "arn:aws:bedrock:::foundation-model/anthropic.claude-haiku-5-5"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "unspecified"
        }
      }
    },
    {
      "Sid": "ApplyOurGuardrail",
      "Effect": "Allow",
      "Action": [
        "bedrock:ApplyGuardrail"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1:<ACCOUNT_ID>:guardrail/<GUARDRAIL_ID>",
        "arn:aws:bedrock:us-east-1:<ACCOUNT_ID>:guardrail-profile/us.guardrail.v1:0",
        "arn:aws:bedrock:us-east-2:<ACCOUNT_ID>:guardrail-profile/us.guardrail.v1:0",
        "arn:aws:bedrock:us-west-2:<ACCOUNT_ID>:guardrail-profile/us.guardrail.v1:0"
      ]
    }
  ]
}
